# Doxyfile 1.9.8
# Configuration for Logic Analyzer Server
# Run: doxygen Doxyfile

# Project info
PROJECT_NAME           = "Logic Analyzer Server"
PROJECT_NUMBER         = "1.3.0"
PROJECT_BRIEF          = "26-channel digital logic analyzer for Raspberry Pi"
PROJECT_LOGO           =

# Output
OUTPUT_DIRECTORY       = ../docs/doxygen/server
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

# Input
INPUT                  = . core hardware net analysis
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.h *.cpp
RECURSIVE              = YES
EXCLUDE                =
EXCLUDE_SYMLINKS       = YES
EXCLUDE_PATTERNS       = */build/* */docs/*
EXAMPLE_PATH           =

# Include sources
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# HTML output
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_HEADER            =
HTML_FOOTER            =
HTML_STYLESHEET        =
HTML_EXTRA_STYLESHEET  =
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
TOC_INCLUDE_HEADINGS   = 5
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO

# LaTeX output
GENERATE_LATEX         = NO

# Diagrams
HAVE_DOT               = NO
DOT_NUM_THREADS        = 0
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_PATH               =
UML_LOOK               = YES
UML_LIMIT_NUM_FIELDS   = 10
TEMPLATE_RELATIONS     = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
GRAPHICAL_HIERARCHY    = YES
GROUP_GRAPHS           = YES

# Extraction
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = YES
SHORT_NAMES            = NO

# Warnings
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
INCLUDE_PATH           = .
INCLUDE_FILE_PATTERNS  =
PREDEFINED             = "GPIO_MMAP=1"
EXPAND_AS_DEFINED      =

# Dot
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 1000

# Other
ALPHABETICAL_INDEX     = YES
IGNORE_PREFIX          =
GENERATE_TAGFILE       =
ALLEXTERNALS           = NO
EXTERNAL_GROUPS        = YES
