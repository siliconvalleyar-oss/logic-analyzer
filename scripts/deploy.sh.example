#!/bin/bash
#==============================================================================
# Deploy to Raspberry Pi — Remote compilation script (EXAMPLE)
#
# Copy this file to scripts/deploy.sh and edit the variables below.
# scripts/deploy.sh is in .gitignore and will NOT be committed.
#
# Usage:
#   ./scripts/deploy.sh
#
# Remote command:
#   ssh <USER>@<HOST> "cd <REMOTE_PATH> && git pull && make clean && make -j4"
#==============================================================================

set -e

# ===== CONFIGURACIÓN (EDITAR) =====
REMOTE_USER="pi"           # Usuario SSH en la Raspberry Pi
REMOTE_HOST="raspberrypi"  # Hostname o IP de la Raspberry Pi
REMOTE_PORT="22"           # Puerto SSH (por defecto 22)
REMOTE_PATH="/home/pi/src/logic-analyzer"  # Ruta del proyecto en la Pi

# ===== FUNCIONES =====
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

# ===== VALIDACIÓN =====
if [ -z "$REMOTE_USER" ] || [ -z "$REMOTE_HOST" ]; then
    error "REMOTE_USER y REMOTE_HOST son obligatorios"
    error "Edita este script y configura las variables"
    exit 1
fi

# ===== DEPLOY =====
info "=== Logic Analyzer — Remote Deploy ==="
info "Target:  ${REMOTE_USER}@${REMOTE_HOST}:${REMOTE_PORT}"
info "Path:    ${REMOTE_PATH}"

# Step 1: Push current code to GitHub
info "[1/4] Pusheando código a GitHub..."
git push origin master --tags

# Step 2: Pull + Compile on remote
info "[2/4] Conectando a ${REMOTE_HOST} para compilar..."
SSH_CMD="cd ${REMOTE_PATH} && git pull && make clean && make -j4"
ssh -p ${REMOTE_PORT} "${REMOTE_USER}@${REMOTE_HOST}" "${SSH_CMD}"

# Step 3: Verify binary exists
info "[3/4] Verificando binario..."
ssh -p ${REMOTE_PORT} "${REMOTE_USER}@${REMOTE_HOST}" "ls -la ${REMOTE_PATH}/server/logic_server"

# Step 4: Done
info "[4/4] ✅ Deploy completado"
info "Abrir: http://${REMOTE_HOST}:8080"
